{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "catalogReleaseId": {
      "type": "string",
      "pattern": "^poe2-(\\d+(?:\\.\\d+){1,3})\\+r(\\d+)$",
      "description": "Data release id, e.g. poe2-<gameVersion>+r<revision>"
    },
    "current": {
      "type": "boolean"
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "classId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "description": "Character class id – internal game id from the data release"
          },
          "ascendancyId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "description": "Ascendancy id – internal game id from the data release"
          },
          "damageRoute": {
            "minItems": 1,
            "maxItems": 200,
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "text"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4000
                    }
                  },
                  "required": [
                    "type",
                    "text"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "calc"
                    },
                    "ref": {
                      "type": "object",
                      "properties": {
                        "calcId": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128,
                          "description": "Id of a single PoB calculation"
                        },
                        "stat": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "calcId",
                        "stat"
                      ]
                    }
                  },
                  "required": [
                    "type",
                    "ref"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "entity"
                    },
                    "ref": {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "enum": [
                            "baseItem",
                            "mod",
                            "uniqueItem",
                            "gem",
                            "passiveNode",
                            "passiveGroup",
                            "characterClass",
                            "ascendancy",
                            "craftingAction",
                            "statTranslation"
                          ],
                          "description": "Kind of catalog entity (Astrolabe's own grouping, not a game concept)"
                        },
                        "id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 512
                        }
                      },
                      "required": [
                        "kind",
                        "id"
                      ]
                    }
                  },
                  "required": [
                    "type",
                    "ref"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "source"
                    },
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
                    }
                  },
                  "required": [
                    "type",
                    "id"
                  ]
                }
              ]
            }
          },
          "defenceConcept": {
            "minItems": 1,
            "maxItems": 200,
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "text"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4000
                    }
                  },
                  "required": [
                    "type",
                    "text"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "calc"
                    },
                    "ref": {
                      "type": "object",
                      "properties": {
                        "calcId": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128,
                          "description": "Id of a single PoB calculation"
                        },
                        "stat": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "calcId",
                        "stat"
                      ]
                    }
                  },
                  "required": [
                    "type",
                    "ref"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "entity"
                    },
                    "ref": {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "enum": [
                            "baseItem",
                            "mod",
                            "uniqueItem",
                            "gem",
                            "passiveNode",
                            "passiveGroup",
                            "characterClass",
                            "ascendancy",
                            "craftingAction",
                            "statTranslation"
                          ],
                          "description": "Kind of catalog entity (Astrolabe's own grouping, not a game concept)"
                        },
                        "id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 512
                        }
                      },
                      "required": [
                        "kind",
                        "id"
                      ]
                    }
                  },
                  "required": [
                    "type",
                    "ref"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "source"
                    },
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
                    }
                  },
                  "required": [
                    "type",
                    "id"
                  ]
                }
              ]
            }
          },
          "keyEntities": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "baseItem",
                    "mod",
                    "uniqueItem",
                    "gem",
                    "passiveNode",
                    "passiveGroup",
                    "characterClass",
                    "ascendancy",
                    "craftingAction",
                    "statTranslation"
                  ],
                  "description": "Kind of catalog entity (Astrolabe's own grouping, not a game concept)"
                },
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              },
              "required": [
                "kind",
                "id"
              ]
            }
          },
          "hypothesis": {
            "minItems": 1,
            "maxItems": 200,
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "text"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4000
                    }
                  },
                  "required": [
                    "type",
                    "text"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "calc"
                    },
                    "ref": {
                      "type": "object",
                      "properties": {
                        "calcId": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128,
                          "description": "Id of a single PoB calculation"
                        },
                        "stat": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "calcId",
                        "stat"
                      ]
                    }
                  },
                  "required": [
                    "type",
                    "ref"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "entity"
                    },
                    "ref": {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "enum": [
                            "baseItem",
                            "mod",
                            "uniqueItem",
                            "gem",
                            "passiveNode",
                            "passiveGroup",
                            "characterClass",
                            "ascendancy",
                            "craftingAction",
                            "statTranslation"
                          ],
                          "description": "Kind of catalog entity (Astrolabe's own grouping, not a game concept)"
                        },
                        "id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 512
                        }
                      },
                      "required": [
                        "kind",
                        "id"
                      ]
                    }
                  },
                  "required": [
                    "type",
                    "ref"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "source"
                    },
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
                    }
                  },
                  "required": [
                    "type",
                    "id"
                  ]
                }
              ]
            }
          }
        },
        "required": [
          "key",
          "title",
          "classId",
          "ascendancyId",
          "damageRoute",
          "defenceConcept",
          "keyEntities",
          "hypothesis"
        ]
      }
    },
    "evaluations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "candidateKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "skeleton": {
            "type": "object",
            "properties": {
              "classId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "description": "Character class id – internal game id from the data release"
              },
              "ascendancyId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "description": "Ascendancy id – internal game id from the data release"
              },
              "level": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "tree": {
                "type": "object",
                "properties": {
                  "allocated": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "nodeId": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 512,
                          "description": "Passive skill id – internal game id from the data release"
                        },
                        "weaponSet": {
                          "default": 0,
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": [
                        "nodeId"
                      ]
                    }
                  },
                  "ascendancy": {
                    "default": [],
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512,
                      "description": "Passive skill id – internal game id from the data release"
                    }
                  }
                },
                "required": [
                  "allocated"
                ]
              },
              "skills": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64
                    },
                    "role": {
                      "type": "string",
                      "enum": [
                        "main",
                        "secondary",
                        "buff",
                        "movement",
                        "utility",
                        "minion"
                      ]
                    },
                    "gem": {
                      "type": "object",
                      "properties": {
                        "gemId": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 512,
                          "description": "Gem id – internal game id from the data release"
                        },
                        "level": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        },
                        "quality": {
                          "default": 0,
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": [
                        "gemId",
                        "level"
                      ]
                    },
                    "supports": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "gemId": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 512,
                            "description": "Gem id – internal game id from the data release"
                          },
                          "level": {
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 9007199254740991
                          },
                          "quality": {
                            "default": 0,
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          }
                        },
                        "required": [
                          "gemId",
                          "level"
                        ]
                      }
                    },
                    "weaponSet": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "key",
                    "role",
                    "gem",
                    "supports"
                  ]
                }
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "slot": {
                      "type": "string",
                      "minLength": 1
                    },
                    "item": {
                      "oneOf": [
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "const": "unique"
                            },
                            "uniqueId": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 512,
                              "description": "Unique item id – internal game id from the data release"
                            },
                            "variantId": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "required": [
                            "kind",
                            "uniqueId"
                          ]
                        },
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "const": "crafted"
                            },
                            "baseItemId": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 512,
                              "description": "Base item type id – internal game id from the data release"
                            },
                            "rarity": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 256,
                              "description": "Classification id defined by the data release (not a fixed enum)"
                            },
                            "itemLevel": {
                              "type": "integer",
                              "exclusiveMinimum": 0,
                              "maximum": 9007199254740991
                            },
                            "mods": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "modId": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 512,
                                    "description": "Mod id – internal game id from the data release"
                                  },
                                  "rollFraction": {
                                    "default": 0.5,
                                    "type": "number",
                                    "minimum": 0,
                                    "maximum": 1
                                  },
                                  "required": {
                                    "type": "boolean"
                                  }
                                },
                                "required": [
                                  "modId",
                                  "required"
                                ]
                              }
                            },
                            "socketables": {
                              "default": [],
                              "type": "array",
                              "items": {
                                "oneOf": [
                                  {
                                    "type": "object",
                                    "properties": {
                                      "kind": {
                                        "type": "string",
                                        "const": "craftingAction"
                                      },
                                      "id": {
                                        "type": "string",
                                        "minLength": 1,
                                        "maxLength": 512,
                                        "description": "Crafting action id – internal game id from the data release"
                                      }
                                    },
                                    "required": [
                                      "kind",
                                      "id"
                                    ]
                                  },
                                  {
                                    "type": "object",
                                    "properties": {
                                      "kind": {
                                        "type": "string",
                                        "const": "baseItem"
                                      },
                                      "id": {
                                        "type": "string",
                                        "minLength": 1,
                                        "maxLength": 512,
                                        "description": "Base item type id – internal game id from the data release"
                                      }
                                    },
                                    "required": [
                                      "kind",
                                      "id"
                                    ]
                                  }
                                ]
                              }
                            }
                          },
                          "required": [
                            "kind",
                            "baseItemId",
                            "rarity",
                            "mods"
                          ]
                        }
                      ]
                    }
                  },
                  "required": [
                    "slot",
                    "item"
                  ]
                }
              },
              "config": {
                "default": {},
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "minLength": 1
                },
                "additionalProperties": {
                  "type": [
                    "boolean",
                    "number",
                    "string"
                  ]
                }
              }
            },
            "required": [
              "classId",
              "level",
              "tree",
              "skills",
              "items"
            ]
          },
          "calcs": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
              "description": "Calc profile id from config/calc-profiles/"
            },
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "const": "ok"
                    },
                    "calcId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "description": "Id of a single PoB calculation"
                    }
                  },
                  "required": [
                    "status",
                    "calcId"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "const": "failed"
                    },
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string",
                          "minLength": 1
                        },
                        "message": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "code",
                        "message"
                      ]
                    }
                  },
                  "required": [
                    "status",
                    "error"
                  ]
                }
              ]
            }
          }
        },
        "required": [
          "candidateKey",
          "skeleton",
          "calcs"
        ]
      }
    },
    "chosenKey": {
      "type": "string",
      "minLength": 1
    },
    "names": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "results": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "calcId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Id of a single PoB calculation"
          },
          "pobVersion": {
            "type": "string",
            "pattern": "^v?\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$",
            "description": "Path of Building PoE2 release tag"
          },
          "dataReleaseId": {
            "type": "string",
            "pattern": "^poe2-(\\d+(?:\\.\\d+){1,3})\\+r(\\d+)$",
            "description": "Data release id, e.g. poe2-<gameVersion>+r<revision>"
          },
          "calcProfile": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
            "description": "Calc profile id from config/calc-profiles/"
          },
          "inputHash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "SHA-256 as lowercase hex"
          },
          "computedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
            "description": "ISO 8601 timestamp"
          },
          "mainSkill": {
            "type": "string",
            "minLength": 1
          },
          "overrides": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1
            },
            "additionalProperties": {
              "type": [
                "boolean",
                "number",
                "string"
              ]
            }
          },
          "stats": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1
            },
            "additionalProperties": {
              "type": "number"
            }
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "unsupportedMods": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "calcId",
          "pobVersion",
          "dataReleaseId",
          "calcProfile",
          "inputHash",
          "computedAt",
          "stats",
          "warnings",
          "unsupportedMods"
        ]
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "runId",
    "catalogReleaseId",
    "current",
    "candidates",
    "evaluations",
    "names",
    "results",
    "unresolved"
  ]
}
