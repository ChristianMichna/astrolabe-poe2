{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "guideId": {
      "type": "string",
      "minLength": 1
    },
    "runId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 3,
            "maxLength": 120,
            "pattern": "^S9\\.[a-z0-9][a-z0-9.-]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "key",
          "label"
        ]
      }
    },
    "comments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "commentId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "section": {
            "type": "string",
            "minLength": 3,
            "maxLength": 120,
            "pattern": "^S9\\.[a-z0-9][a-z0-9.-]*$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
            "description": "ISO 8601 timestamp"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "working",
              "applied",
              "failed"
            ]
          }
        },
        "required": [
          "commentId",
          "section",
          "text",
          "createdAt",
          "status"
        ]
      }
    }
  },
  "required": [
    "guideId",
    "sections",
    "comments"
  ]
}
