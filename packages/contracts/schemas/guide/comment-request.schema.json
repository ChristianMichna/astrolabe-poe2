{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "section": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120,
      "pattern": "^(?:S9\\.|S8\\.craft-|S7\\.gear-)[a-z0-9][a-z0-9.-]*$|^S6\\.notes$|^S5\\.gems$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    }
  },
  "required": [
    "section",
    "text"
  ]
}
